@page "/calendarevents"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using shared_calendar.Models
@using shared_calendar.Data
@rendermode InteractiveServer
@inject EventManager manager

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="calendarevents/create">Create New</a>
</p>

<QuickGrid Class="table" TGridItem="CalendarEvent" Items="@events">
    <PropertyColumn Property="calendarevent => calendarevent.Date" />
    <PropertyColumn Property="calendarevent => calendarevent.StartTime" />
    <PropertyColumn Property="calendarevent => calendarevent.EndTime" />
    <PropertyColumn Property="calendarevent => calendarevent.Title" />
    <PropertyColumn Property="calendarevent => calendarevent.Description" />

    <TemplateColumn Context="calendarevent">
        <a href="@($"calendarevents/edit?id={calendarevent.id}")">Edit</a> |
        <a href="@($"calendarevents/details?id={calendarevent.id}")">Details</a> |
        <a href="@($"calendarevents/delete?id={calendarevent.id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private IQueryable<CalendarEvent> events;

    protected override void OnInitialized()
    {
        this.events = manager.GetEvents().AsQueryable();
    }
}
