@using MudBlazor
@* returns DateTime obj that represents the date and time of and event specified by the user *@

<div>
    <MudDatePicker Label="Date" @bind-Date="Date" />
    <TimePicker @bind-SelectedTime="SelectedTime" />
</div>

@code {
    private DateTime? date = DateTime.Now;
    private TimeOnly time = TimeOnly.FromDateTime(DateTime.Now);

    [Parameter]
    public DateTime SelectedDateTime
    {
        get
        {
            return new DateTime(DateOnly.FromDateTime(this.Date.GetValueOrDefault().Date), this.SelectedTime);
        }

        set
        {
            this.Date = value.Date;
            this.SelectedTime = TimeOnly.FromDateTime(value); // this sets the time to military time 
            this.SelectedDateTimeChanged.InvokeAsync(SelectedDateTime);
        }
    }

    [Parameter]
    public DateTime? Date
    { 
        get { return this.date; }

        set
        {
            this.date = value;
            this.DateChanged.InvokeAsync(Date.GetValueOrDefault());
            this.SelectedDateTimeChanged.InvokeAsync(this.SelectedDateTime);
        }
    }

    [Parameter]
    public TimeOnly SelectedTime
    {
        get { return this.time; }

        set
        {
            this.time = value;
            this.SelectedTimeChanged.InvokeAsync(this.SelectedTime);
            this.SelectedDateTimeChanged.InvokeAsync(this.SelectedDateTime);
        }
    }

    [Parameter]
    public EventCallback<DateTime> SelectedDateTimeChanged { get; set; }

    [Parameter]
    public EventCallback<DateTime> DateChanged { get; set; }

    [Parameter]
    public EventCallback<TimeOnly> SelectedTimeChanged { get; set; }
}