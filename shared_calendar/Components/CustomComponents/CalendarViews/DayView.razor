@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using shared_calendar.Data
@using shared_calendar.Models
@inject EventManager manager;
<h3>Day View</h3>

<MudGrid Spacing="0" Justify="Justify.Center">
    @for (int hour = 0; hour < 24; hour++)
    {
        <MudItem xs="12">
            <MudPaper Class="pa-2" Outlined="true">

                <div class="d-flex justify-space-between">
                    <strong>@hour:00</strong>
                </div>
                
                @foreach (var item in eventsForTheDay)
                {
                    if (item.StartDateTime.Hour == hour) // check if an event occurs in this hour 
                    {
                        <MudCard Class="my-2" Style="background-color:lightblue;">
                            <MudCardContent>
                                <div>
                                    <strong>@item.Title</strong>
                                </div>
                                <div>
                                    @item.StartDateTime:0Date0 - @item.EndDateTime:00
                                </div>
                                <div>
                                    @item.Description
                                </div>
                            </MudCardContent>
                        </MudCard>
                    }
                }

            </MudPaper>
        </MudItem>
    }
</MudGrid>

    @code {

    [Parameter]
    public DateTime date { get; set; }
    private List<CalendarEvent> eventsForTheDay = new();

    protected override void OnInitialized()
    {
        eventsForTheDay = manager.GetEvents(DateTime.Now, null);
    }
}