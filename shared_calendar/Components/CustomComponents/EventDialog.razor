@using MudBlazor
@using Microsoft.EntityFrameworkCore
@using shared_calendar.Models
@inject IDbContextFactory<shared_calendar.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
<MudDialog>
    <TitleContent>
        Event Details
    </TitleContent>

    <DialogContent>
        @if (calendarevent is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">Start</dt>
                <dd class="col-sm-10">@calendarevent.StartDateTime</dd>

                <dt class="col-sm-2">End</dt>
                <dd class="col-sm-10">@calendarevent.EndDateTime</dd>

                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@calendarevent.Title</dd>

                <dt class="col-sm-2">Description</dt>
                <dd class="col-sm-10">@calendarevent.Description</dd>
            </dl>
        }
    </DialogContent>
</MudDialog>


@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();

    private CalendarEvent? calendarevent;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        calendarevent = await context.CalendarEvent.FirstOrDefaultAsync(m => m.id == Id);

        if (calendarevent is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
